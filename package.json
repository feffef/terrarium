{
  "name": "terrarium",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "postinstall": "git config core.hooksPath .githooks 2>/dev/null || true && nuxt prepare",
    "dev": "nuxt dev",
    "build": "nuxt build",
    "generate": "nuxt generate",
    "preview": "nuxt preview",
    "typecheck": "nuxt typecheck && tsc -p tsconfig.node.json",
    "lint": "eslint .",
    "test": "nuxt prepare && vitest run tests/unit",
    "test:e2e": "vitest run tests/e2e",
    "validate:content": "tsx scripts/validate-content.ts && tsx scripts/validate-content-refs.ts && tsx scripts/validate-skill-cadence.ts && tsx scripts/validate-prune-trials.ts",
    "verify:skills-lock": "tsx scripts/verify-skills-lock.ts",
    "verify:mermaid": "tsx scripts/verify-mermaid.ts",
    "render:mermaid": "tsx scripts/render-mermaid.ts",
    "check:worktrees": "tsx scripts/check-worktrees.ts",
    "gate": "pnpm verify:skills-lock && pnpm verify:mermaid && pnpm lint && pnpm typecheck && pnpm validate:content && pnpm test && pnpm build && pnpm test:e2e",
    "gate:scoped": "tsx scripts/gate.ts"
  },
  "dependencies": {
    "@nuxt/content": "^3.16.1",
    "nuxt": "^4.5.2",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@nuxt/eslint": "^1.17.0",
    "@nuxt/kit": "^4.5.2",
    "@nuxt/test-utils": "^4.3.3",
    "@types/node": "^22.20.5",
    "eslint": "^10.12.0",
    "jiti": "^2.7.0",
    "mermaid": "^11.17.2",
    "playwright-core": "^1.63.0",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "vitest": "^5.0.3",
    "vue-tsc": "^3.3.12",
    "yaml": "^2.9.1"
  }
}
