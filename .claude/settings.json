{
  "permissions": {
    "allow": [
      "mcp__github__create_pull_request",
      "mcp__github__subscribe_pr_activity",
      "mcp__github__unsubscribe_pr_activity",
      "mcp__github__pull_request_read"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "TaskCreate|Monitor",
        "hooks": [
          {
            "type": "command",
            "command": "pnpm exec tsx scripts/deferred-tool-guard.ts || true"
          }
        ]
      },
      {
        "matcher": "ScheduleWakeup",
        "hooks": [
          {
            "type": "command",
            "command": "sh scripts/guard-wrap.sh loop-only-tool-guard -- pnpm exec tsx scripts/loop-only-tool-guard.ts"
          }
        ]
      },
      {
        "matcher": "Skill",
        "hooks": [
          {
            "type": "command",
            "command": "sh scripts/guard-wrap.sh skill-inline-guard -- pnpm exec tsx scripts/skill-inline-guard.ts"
          }
        ]
      },
      {
        "matcher": "Agent",
        "hooks": [
          {
            "type": "command",
            "command": "sh scripts/guard-wrap.sh agent-background-flag-guard -- pnpm exec tsx scripts/agent-background-flag-guard.ts"
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "sh scripts/guard-wrap.sh subagent-background-guard -- sh scripts/subagent-background-guard.sh"
          },
          {
            "type": "command",
            "command": "sh scripts/guard-wrap.sh commit-trailer-guard -- sh scripts/commit-trailer-guard.sh"
          },
          {
            "type": "command",
            "command": "sh scripts/guard-wrap.sh tail-pipe-guard -- sh scripts/tail-pipe-guard.sh"
          },
          {
            "type": "command",
            "command": "sh scripts/guard-wrap.sh double-background-guard -- sh scripts/double-background-guard.sh"
          }
        ]
      },
      {
        "matcher": "Monitor",
        "hooks": [
          {
            "type": "command",
            "command": "sh scripts/guard-wrap.sh subagent-background-guard -- pnpm exec tsx scripts/subagent-background-guard.ts"
          }
        ]
      },
      {
        "matcher": "Edit|Write|Bash",
        "hooks": [
          {
            "type": "command",
            "command": "sh scripts/guard-wrap.sh workflow-edit-guard -- sh scripts/workflow-edit-guard.sh"
          }
        ]
      },
      {
        "matcher": "mcp__github__add_issue_comment|mcp__github__add_reply_to_pull_request_comment|mcp__github__create_pull_request|mcp__github__update_pull_request|mcp__github__pull_request_review_write|mcp__github__add_comment_to_pending_review|mcp__github__issue_write|mcp__github__create_or_update_file|mcp__github__push_files",
        "hooks": [
          {
            "type": "command",
            "command": "sh scripts/guard-wrap.sh github-provenance-guard -- pnpm exec tsx scripts/github-provenance-guard.ts"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "startup|resume",
        "hooks": [
          {
            "type": "command",
            "command": "pnpm install"
          },
          {
            "type": "command",
            "command": "pnpm exec tsx scripts/unshallow-on-start.ts || true"
          }
        ]
      },
      {
        "matcher": "resume",
        "hooks": [
          {
            "type": "command",
            "command": "[ -f .session-logs/pending.scratch.json ] && pnpm exec tsx scripts/log-session.ts --land || true"
          }
        ]
      }
    ],
    "Stop": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "[ -f .session-logs/pending.scratch.json ] && pnpm exec tsx scripts/log-session.ts --land || true"
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "matcher": "clear|resume|logout|prompt_input_exit|bypass_permissions_disabled|other",
        "hooks": [
          {
            "type": "command",
            "command": "pnpm exec tsx scripts/log-session.ts --land"
          }
        ]
      }
    ]
  }
}
