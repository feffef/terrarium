{
  // Type-checks the node/tsx-side code that `nuxt typecheck` does NOT cover — its
  // generated tsconfig includes only the Nuxt app surface (app/, shared/, config),
  // never scripts/ or tests/. Run as the second half of `pnpm typecheck` so the
  // session-log helper and the shared isolation code are gated like the rest (ADR-0004).
  //
  // `content.config.ts` belongs here rather than in the Nuxt program: it runs in
  // the node/config context (evaluated by jiti at `nuxt prepare`/`build` time, not
  // inside the Vue/app compile), and it already imports `shared/expand.ts` — which
  // this program covers. It defines the very `Collections` keys other code depends
  // on (issue #93), and until now sat in NO tsconfig, so a type error there was
  // invisible to `pnpm typecheck`. (The tenant manifests it loads are typechecked
  // separately, via the Nuxt program's `../layers/*/tenant.config.*` include in
  // `nuxt.config.ts` — a file should be typechecked by exactly one program.)
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    // scripts import sibling modules by explicit `.ts` path (tsx runtime); allow it.
    "allowImportingTsExtensions": true,
    "noEmit": true,
    // Cached across CI runs with the lint cache (.github/actions/gate/action.yml).
    "incremental": true,
    "tsBuildInfoFile": "./node_modules/.cache/tsc/node.tsbuildinfo",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "types": ["node"],
    // shared/routing.ts imports from #routing (ADR-0014 virtual module). Mirror the
    // alias that nuxt registers so `tsc -p tsconfig.node.json` can resolve it too.
    // .nuxt/routing.d.ts is generated by `nuxt prepare` (run via postinstall).
    // `#shared` too: a Tenant unit spec imports an app util that reaches shared/ by it.
    "paths": {
      "#routing": ["./.nuxt/routing.d.ts"],
      "#catalog": ["./.nuxt/catalog.d.ts"],
      "#shared/*": ["./shared/*"]
    }
  },
  // Platform tests live in `tests/`; Tenant-specific tests live in their layer
  // under `layers/<tenant>/tests/` (tests/README.md). Unit and e2e specs, and the
  // e2e support module, are all checked here; the `DOM` libs above type the
  // e2e specs' `page.evaluate` bodies (#2069).
  "include": [
    "scripts/**/*.ts",
    "shared/**/*.ts",
    "tests/unit/**/*.ts",
    "layers/*/tests/unit/**/*.ts",
    "tests/e2e/**/*.ts",
    "layers/*/tests/e2e/**/*.ts",
    "tests/support/**/*.ts",
    // A Skill's helper scripts and their unit tests (#1603).
    ".agents/skills/*/scripts/**/*.ts",
    ".agents/skills/*/tests/unit/**/*.ts",
    "content.config.ts"
  ],
  // These unit specs exercise browser-side app modules: the accordion/deep-link
  // composable (issue #450) and Glass Box's revision.ts pull in `vue` and Nuxt
  // globals, which this node/tsx program doesn't load. The Nuxt program typechecks
  // both modules (`layers/*/app/**/*`), and each spec asserts its contract at
  // runtime, so a changed signature still fails `pnpm test`.
  // `node_modules` is listed because naming `exclude` at all replaces TypeScript's
  // implicit default (`node_modules`, `bower_components`, `jspm_packages`, outDir).
  "exclude": [
    "node_modules",
    "layers/journal/tests/unit/accordion-deep-link.spec.ts",
    "layers/glassbox/tests/unit/revision.spec.ts"
  ]
}
